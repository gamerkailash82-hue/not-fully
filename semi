    lbPadding.PaddingBottom = UDim.new(0, 5)
    lbPadding.PaddingLeft = UDim.new(0, 5)
    lbPadding.PaddingRight = UDim.new(0, 5)
    lbPadding.Parent = LBScroll

    local function createRow(rank, name, value, isMe)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -10, 0, 28)
        row.BackgroundColor3 = isMe and Color3.fromRGB(40, 70, 50) or Color3.fromRGB(32, 28, 48)
        row.BorderSizePixel = 0
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

