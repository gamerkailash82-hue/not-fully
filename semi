    RankLabel.Parent = LBContent

    -- Status
    local LBStatusLabel = Instance.new("TextLabel")
    LBStatusLabel.Size = UDim2.new(1, 0, 0, 16)
    LBStatusLabel.Position = UDim2.fromOffset(0, 50)
    LBStatusLabel.BackgroundTransparency = 1
    LBStatusLabel.Font = Enum.Font.Gotham
    LBStatusLabel.Text = "Connecting..."
    LBStatusLabel.TextColor3 = Color3.fromRGB(140, 135, 165)
    LBStatusLabel.TextSize = 10
    LBStatusLabel.TextXAlignment = Enum.TextXAlignment.Left
    LBStatusLabel.Parent = LBContent

    -- List
    local LBScroll = Instance.new("ScrollingFrame")
    LBScroll.Size = UDim2.new(1, 0, 1, -72)
    LBScroll.Position = UDim2.fromOffset(0, 70)
    LBScroll.BackgroundColor3 = Color3.fromRGB(25, 20, 40)
