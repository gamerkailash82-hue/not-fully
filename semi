    LBScroll.ScrollBarThickness = 4
    LBScroll.ScrollBarImageColor3 = Color3.fromRGB(90, 140, 150)
    LBScroll.CanvasSize = UDim2.fromOffset(0, 0)
    LBScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    LBScroll.Parent = LBContent
    Instance.new("UICorner", LBScroll).CornerRadius = UDim.new(0, 8)

