-- Wrapped in do...end so its locals don't clash with the ones above.

do
    local Timeframes = {"Daily", "Monthly", "AllTime"}
    local currentTF = LB_DEFAULT_TIMEFRAME
    local tfButtons = {}

    -- Timeframe buttons
    local btnFrame = Instance.new("Frame")
    btnFrame.Size = UDim2.new(1, 0, 0, 26)
