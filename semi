-- ====================== FISH LOGIC ======================

local function updateUI()
    KeyLabel.Text = "Key: " .. State.DetectedKey
    if SETTINGS.FishLimit > 0 then
        StatusLabel.Text = "Status: " .. State.Status .. "  (" .. State.FishCaught .. "/" .. SETTINGS.FishLimit .. ")"
    else
        StatusLabel.Text = "Status: " .. State.Status .. "  (Caught: " .. State.FishCaught .. ")"
    end
end

local function updateTimer()
    if not State.IsRunning then return end
    State.ElapsedTime = os.clock() - State.StartTime
    local mins = math.floor(State.ElapsedTime / 60)
    local secs = math.floor(State.ElapsedTime % 60)
    TimerLabel.Text = string.format("Time: %02d:%02d", mins, secs)
end

local keyMap = { W = Enum.KeyCode.W, A = Enum.KeyCode.A, S = Enum.KeyCode.S, D = Enum.KeyCode.D }

local function pressKey(keyCode)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(SETTINGS.KeyHoldTime)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

local function mouseDown(x, y)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
end

local function mouseUp(x, y)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function clickObject(obj)
    if not obj or not obj.Visible then return end
    local size = obj.AbsoluteSize
    if size.X < 5 or size.Y < 5 then return end
    local pos = obj.AbsolutePosition + (size / 2)
    mouseDown(pos.X, pos.Y)
    task.wait(SETTINGS.ClickDelay)
    mouseUp(pos.X, pos.Y)
end

local function holdOnScreen(holdTime)
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
    local x, y = vp.X * 0.5, vp.Y * 0.5
    VirtualInputManager:SendMouseMoveEvent(x, y, game)
    task.wait(0.03)
    mouseDown(x, y)
    local t0 = os.clock()
    while os.clock() - t0 < holdTime do task.wait() end
    mouseUp(x, y)
end

local function getFishingGui()
    return PlayerGui:FindFirstChild("FishingGui")
end

local function norm(t)
    return string.upper(string.gsub(t, "%s+", ""))
end

local function isShown(obj)
    local cur = obj
    while cur and cur ~= PlayerGui do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return cur == PlayerGui
end

local castButton, castLabel = nil, nil
local lastScan = 0
local scanning = false

local function scanForCast()
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v.Parent and (v:IsA("TextLabel") or v:IsA("TextButton"))
            and norm(v.Text) == "CAST"
            and not v:IsDescendantOf(ScreenGui) then

            local obj = v
            while obj and obj ~= PlayerGui and not obj:IsA("GuiButton") do
                obj = obj.Parent
            end
            castLabel = v
            castButton = (obj and obj ~= PlayerGui) and obj or v
            return
        end
    end
end

local function findCastButton()
    if castLabel and castLabel:IsDescendantOf(PlayerGui) then
        if norm(castLabel.Text) == "CAST" and isShown(castLabel) then
            return castButton
        end
        return nil
    end
    castLabel, castButton = nil, nil
    if not scanning and os.clock() - lastScan > 0.5 then
        scanning = true
        lastScan = os.clock()
        pcall(scanForCast)
        scanning = false
    end
    return nil
end

