    local btnLayout = Instance.new("UIListLayout")
    btnLayout.FillDirection = Enum.FillDirection.Horizontal
    btnLayout.Padding = UDim.new(0, 6)
    btnLayout.Parent = btnFrame

    local function updateTFButtons()
        for name, btn in pairs(tfButtons) do
            if name == currentTF then
                btn.BackgroundColor3 = Color3.fromRGB(60, 160, 100)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
                btn.TextColor3 = Color3.fromRGB(180, 175, 200)
            end
        end
    end

    for _, tf in ipairs(Timeframes) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1 / 3, -4, 1, 0)
        btn.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
        btn.Text = tf
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 11
        btn.TextColor3 = Color3.fromRGB(180, 175, 200)
        btn.AutoButtonColor = false
        btn.Parent = btnFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        btn.MouseButton1Click:Connect(function()
            currentTF = tf
            updateTFButtons()
            if _G.ForceMasterAnglers then
                task.spawn(_G.ForceMasterAnglers)
            end
        end)
        tfButtons[tf] = btn
    end
    updateTFButtons()

    -- Your Rank
    local RankLabel = Instance.new("TextLabel")
    RankLabel.Size = UDim2.new(1, 0, 0, 20)
    RankLabel.Position = UDim2.fromOffset(0, 30)
