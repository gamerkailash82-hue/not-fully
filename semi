local DEFAULTS = {
    CastHoldTime = 0.9,
    CastCooldown = 0.0,
    TapCooldown = 0.001,
    KeyHoldTime = 0.001,
    ClickDelay = 0.001,
    ScanInterval = 0.01,
    FishLimit = 50,
}

local SETTINGS = {}

for k, v in pairs(DEFAULTS) do
    local ok, saved = pcall(function()
        return typeof(readfile) == "function" and tonumber(readfile("autofish_" .. k .. ".txt"))
    end)
    SETTINGS[k] = (ok and saved) or v
end

local function saveSetting(key)
    pcall(function()
        if typeof(writefile) == "function" then
            writefile("autofish_" .. key .. ".txt", tostring(SETTINGS[key]))
        end
    end)
end

