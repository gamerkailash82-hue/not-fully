        rankLabel.Size = UDim2.fromOffset(38, 28)
        rankLabel.Position = UDim2.fromOffset(6, 0)
        rankLabel.BackgroundTransparency = 1
        rankLabel.Font = Enum.Font.GothamBold
        rankLabel.Text = "#" .. rank
        rankLabel.TextColor3 = rank == 1 and Color3.fromRGB(255, 215, 80)
            or rank == 2 and Color3.fromRGB(200, 200, 220)
            or rank == 3 and Color3.fromRGB(220, 160, 100)
            or Color3.fromRGB(180, 175, 200)
        rankLabel.TextSize = 11
        rankLabel.TextXAlignment = Enum.TextXAlignment.Left
        rankLabel.Parent = row

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -125, 1, 0)
        nameLabel.Position = UDim2.fromOffset(44, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Font = Enum.Font.GothamMedium
        nameLabel.Text = name
        nameLabel.TextColor3 = isMe and Color3.fromRGB(160, 255, 180) or Color3.fromRGB(230, 225, 240)
        nameLabel.TextSize = 11
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
        nameLabel.Parent = row

        local valueLabel = Instance.new("TextLabel")
        valueLabel.Size = UDim2.fromOffset(75, 28)
        valueLabel.Position = UDim2.new(1, -81, 0, 0)
        valueLabel.BackgroundTransparency = 1
        valueLabel.Font = Enum.Font.GothamBold
        valueLabel.Text = tostring(value)
        valueLabel.TextColor3 = Color3.fromRGB(255, 205, 70)
        valueLabel.TextSize = 11
        valueLabel.TextXAlignment = Enum.TextXAlignment.Right
        valueLabel.Parent = row

        return row
    end

    -- Logic
    task.spawn(function()
        local RemoteBridge
        local success = false

        for i = 1, 15 do
            if not ScreenGui.Parent then return end

            local ok, result = pcall(function()
                local ps = LocalPlayer:FindFirstChild("PlayerScripts")
                if not ps then return nil end
                local lb = ps:FindFirstChild("LeaderBoardClient") or ps:WaitForChild("LeaderBoardClient", 1)
                if not lb then return nil end
                local bridge = lb:FindFirstChild("RemoteBridge")
                if bridge then
                    return require(bridge)
                end
            end)

            if ok and result and type(result.RequestLeaderboard) == "function" then
                RemoteBridge = result
                success = true
                break
            end
            LBStatusLabel.Text = "Waiting for bridge... (" .. i .. ")"
            task.wait(1)
        end

        if not success then
            LBStatusLabel.Text = "Failed to get RemoteBridge"
            return
        end

        LBStatusLabel.Text = "Connected!"

        local function clearList()
            for _, child in ipairs(LBScroll:GetChildren()) do
                if child:IsA("Frame") then
                    child:Destroy()
                end
            end
        end

        local function request()
            if not ScreenGui.Parent then return end
            LBStatusLabel.Text = "Requesting " .. currentTF .. "..."

            pcall(function()
                RemoteBridge.RequestLeaderboard("TotalFishCaught", currentTF, function(entries, extras)
                    if not ScreenGui.Parent then return end
                    clearList()

                    if type(entries) ~= "table" or #entries == 0 then
                        RankLabel.Text = "Your Rank: Not ranked"
                        LBStatusLabel.Text = "No data (" .. currentTF .. ")"
                        return
                    end

                    local myRankText = "Not ranked"
                    local maxShow = math.min(LB_SHOW_AMOUNT, #entries)

                    for i = 1, maxShow do
                        local e = entries[i]
                        local id = e.UserId or e.id
                        local name = e.Name or e.name or "Unknown"
                        local value = e.Value or e.value or 0
                        local rank = e.rank or i
                        local isMe = id == LocalPlayer.UserId

                        if isMe then
                            myRankText = string.format("#%s  (%s fish)", tostring(rank), tostring(value))
                        end

                        local row = createRow(rank, name, value, isMe)
                        row.LayoutOrder = i
                        row.Parent = LBScroll
                    end

                    RankLabel.Text = "Your Rank:  " .. myRankText
                    LBStatusLabel.Text = currentTF .. " • Top " .. maxShow .. " • " .. os.date("%H:%M:%S")
                end)
            end)
        end

        _G.ForceMasterAnglers = request

        request()

        -- Auto refresh only while the Leaderboard tab is open
        while ScreenGui.Parent do
            task.wait(LB_REFRESH_TIME)
            if ScreenGui.Parent and LBContent.Visible and not State.IsMinimized then
                request()
            end
        end
    end)
end

